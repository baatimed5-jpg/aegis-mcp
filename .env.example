# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aegis
DATABASE_URL=postgresql+asyncpg://aegis:change-me@localhost:5432/aegis
REDIS_URL=redis://localhost:6379/0

# LLM providers (used from Phase 4)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-placeholder
GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key

# Agent API keys for the gateway (used from Phase 3)
AGENT_TOKEN_ASSISTANT=change-me
